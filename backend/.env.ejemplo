# Copie este archivo como .env y reemplace los secretos.
# Generar un secreto:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SISGEF_ENTORNO=desarrollo
SISGEF_DATABASE_URL=sqlite:///./sisgef.db
# PostgreSQL local (contenedor del compose.yaml):
# SISGEF_DATABASE_URL=postgresql+psycopg://sisgef:sisgef_local@localhost:5432/sisgef
SISGEF_JWT_SECRETO=cambie-este-valor-por-un-secreto-largo-y-aleatorio
SISGEF_HMAC_SECRETO=cambie-este-valor-por-otro-secreto-distinto
SISGEF_JWT_MINUTOS=30
SISGEF_PBKDF2_ITERACIONES=600000
